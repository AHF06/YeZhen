{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/history/history",
      "style": {
        "navigationBarTitleText": "植保档案",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/community/community",
      "style": {
        "navigationBarTitleText": "农友圈",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    }
  ],
  "subPackages": [
    {
      "root": "subpages",
      "pages": [
        {
          "path": "login/login",
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "register/register",
          "style": {
            "navigationBarTitleText": "注册",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "ai/ai",
          "style": {
            "navigationBarTitleText": "AI助手",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "warning/warning",
          "style": {
            "navigationBarTitleText": "病虫害预警",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "result/result",
          "style": {
            "navigationBarTitleText": "识别结果"
          }
        },
        {
          "path": "myposts/myposts",
          "style": {
            "navigationBarTitleText": "我的动态"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["subpages"]
    },
    "pages/community/community": {
      "network": "all",
      "packages": ["subpages"]
    },
    "pages/history/history": {
      "network": "all",
      "packages": ["subpages"]
    }
  },
  "tabBar": {
    "color": "#8a9a7a",
    "selectedColor": "#2c5e2a",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/shouye.jpg",
        "selectedIconPath": "static/shouye.jpg"
      },
      {
        "pagePath": "pages/history/history",
        "text": "植保档案",
        "iconPath": "static/dangan.jpg",
        "selectedIconPath": "static/dangan.jpg"
      },
      {
        "pagePath": "pages/community/community",
        "text": "农友圈",
        "iconPath": "static/community.jpg",
        "selectedIconPath": "static/community.jpg"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "个人中心",
        "iconPath": "static/mine.jpg",
        "selectedIconPath": "static/mine.jpg"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "叶诊",
    "navigationBarBackgroundColor": "#2c5e2a",
    "backgroundColor": "#F8F8F8"
  },
  "uniIdRouter": {
    "loginPage": "subpages/login/login",
    "needLogin": [
      "pages/index/index",
      "pages/history/history",
      "pages/community/community",
      "pages/mine/mine",
      "subpages/ai/ai",
      "subpages/warning/warning",
      "subpages/result/result",
      "subpages/myposts/myposts"
    ],
    "resLogout": [
      "pages/index/index",
      "pages/history/history",
      "pages/community/community"
    ]
  }
}